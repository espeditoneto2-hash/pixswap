</footer>

<!-- ═══ MODAL ═══ -->
<div class="overlay" id="overlay">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-head">
      <div>
        <h3 id="modalTitle">Transação</h3>
        <div class="m-sub" id="modalSub"></div>
      </div>
      <button class="x-btn" onclick="closeModal()" aria-label="Fechar">✕</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
/* ═══ ESTADO ══════════════════════════════════════════════ */
const API = ''; // mesmo host do backend
let dir = 'pix2usdt';
let net = 'trc20';
let rate = null;
let feePct = 1.0, minBRL = 20;
let backendOnline = false;
let pollTimer = null, countdownTimer = null;

const $ = id => document.getElementById(id);

/* ═══ COTAÇÃO ═════════════════════════════════════════════ */
async function loadRate() {
  // 1º tenta o backend (traz taxa e limites configurados)
  try {
    const r = await fetch(API + '/api/rate', { signal: AbortSignal.timeout(4000) });
    const d = await r.json();
    if (d.success) {
      rate = d.rate; feePct = d.feePercent; minBRL = d.minBRL;
      backendOnline = true;
      $('demoNote').classList.remove('show');
      paintRate(); return;
    }
  } catch (e) { /* backend offline */ }

  // 2º fallback: Binance pública (página funciona standalone)
  backendOnline = false;
  $('demoNote').classList.add('show');
  try {
    const r = await fetch('https://api.binance.com/api/v3/ticker/price?symbol=USDTBRL');
    const d = await r.json();
    rate = parseFloat(d.price);
  } catch (e) {
    rate = rate || 5.75;
  }
  paintRate();
}

function paintRate() {
  if (!rate) return;
  $('navRate').textContent = `1 USDT = R$ ${rate.toFixed(2)}`;
  $('statRate').textContent = `R$ ${rate.toFixed(2)}`;
  $('lblMin').textContent = dir === 'pix2usdt' ? `mínimo R$ ${minBRL}` : `mínimo ${(minBRL / rate).toFixed(2)} USDT`;
  quote();
}

/* ═══ DIREÇÃO / REDE ══════════════════════════════════════ */
function setDir(d) {
  dir = d;
  const p2u = d === 'pix2usdt';
  $('tabP2U').classList.toggle('on', p2u);
  $('tabU2P').classList.toggle('on', !p2u);
  $('tabP2U').setAttribute('aria-selected', p2u);
  $('tabU2P').setAttribute('aria-selected', !p2u);

  $('lblSend').textContent = p2u ? 'Você paga' : 'Você envia';
  $('dotFrom').textContent = p2u ? 'R$' : '$';
  $('dotFrom').className = 'cur-dot ' + (p2u ? 'brl' : 'usdt');
  $('codeFrom').textContent = p2u ? 'BRL' : 'USDT';
  $('lblRecv').textContent = p2u ? 'Você recebe (USDT)' : 'Você recebe (BRL)';
  $('lblDest').textContent = p2u ? 'Sua carteira USDT' : 'Sua chave Pix';
  $('inDest').placeholder = p2u ? (net === 'trc20' ? 'T...' : '0x...') : 'CPF, e-mail, telefone ou chave aleatória';
  $('btnGo').textContent = p2u ? 'Gerar QR Code Pix' : 'Gerar endereço de depósito';

  $('inAmount').value = ''; $('inDest').value = '';
  $('outAmount').textContent = p2u ? '0.0000' : 'R$ 0,00';
  $('feeBox').classList.remove('show');
  $('destMsg').textContent = ''; $('inDest').className = 'text-input';
  paintRate(); checkReady();
}

function setNet(n) {
  net = n;
  $('chipTrc').classList.toggle('on', n === 'trc20');
  $('chipErc').classList.toggle('on', n === 'erc20');
  $('chipTrc').setAttribute('aria-checked', n === 'trc20');
  $('chipErc').setAttribute('aria-checked', n === 'erc20');
  if (dir === 'pix2usdt') {
    $('inDest').placeholder = n === 'trc20' ? 'T...' : '0x...';
    validateDest();
  }
}

/* ═══ COTAÇÃO EM TEMPO REAL ═══════════════════════════════ */
function quote() {
  const amt = parseFloat($('inAmount').value);
  if (!amt || amt <= 0 || !rate) {
    $('outAmount').textContent = dir === 'pix2usdt' ? '0.0000' : 'R$ 0,00';
    $('feeBox').classList.remove('show');
    checkReady(); return;
  }

  const fee = feePct / 100;
  if (dir === 'pix2usdt') {
    const gross = amt / rate, net_ = gross * (1 - fee);
    $('outAmount').textContent = net_.toFixed(4);
    $('fRate').textContent = `R$ ${rate.toFixed(4)}`;
    $('fFee').textContent = `${(gross * fee).toFixed(4)} USDT`;
    $('fTotal').textContent = `${net_.toFixed(4)} USDT`;
  } else {
    const gross = amt * rate, net_ = gross * (1 - fee);
    $('outAmount').textContent = `R$ ${net_.toFixed(2).replace('.', ',')}`;
    $('fRate').textContent = `R$ ${rate.toFixed(4)}`;
    $('fFee').textContent = `R$ ${(gross * fee).toFixed(2)}`;
    $('fTotal').textContent = `R$ ${net_.toFixed(2).replace('.', ',')}`;
  }
  $('feeBox').classList.add('show');
  checkReady();
}

/* ═══ VALIDAÇÃO DE DESTINO ════════════════════════════════ */
function validateDest() {
  const v = $('inDest').value.trim();
  const msg = $('destMsg'), inp = $('inDest');
  if (!v) { msg.textContent = ''; inp.className = 'text-input'; checkReady(); return; }

  let ok = false, txt = '';
  if (dir === 'pix2usdt') {
    if (net === 'trc20') {
      ok = /^T[A-Za-z0-9]{33}$/.test(v);
      txt = ok ? 'Endereço TRC-20 válido' : 'Endereço TRC-20 começa com T e tem 34 caracteres';
    } else {
      ok = /^0x[a-fA-F0-9]{40}$/.test(v);
      txt = ok ? 'Endereço ERC-20 válido' : 'Endereço ERC-20 começa com 0x e tem 42 caracteres';
    }
  } else {
    ok = v.length >= 5;
    txt = ok ? 'Chave Pix registrada' : 'Digite uma chave Pix válida';
  }
  msg.textContent = txt;
  msg.className = 'field-msg ' + (ok ? 'ok' : 'bad');
  inp.className = 'text-input ' + (ok ? 'ok' : 'bad');
  checkReady();
}

function checkReady() {
  const amt = parseFloat($('inAmount').value);
  const destOk = $('inDest').classList.contains('ok');
  let amtOk = false;
  if (amt > 0 && rate) {
    amtOk = dir === 'pix2usdt' ? amt >= minBRL : (amt * rate) >= minBRL;
  }
  $('btnGo').disabled = !(amtOk && destOk);
}

/* ═══ INICIAR SWAP ════════════════════════════════════════ */
async function startSwap() {
  const amt = parseFloat($('inAmount').value);
  const dest = $('inDest').value.trim();

  $('btnGo').disabled = true;
  $('btnGo').textContent = 'Criando transação...';

  try {
    if (backendOnline) {
      const endpoint = dir === 'pix2usdt' ? '/api/swap/pix2usdt' : '/api/swap/usdt2pix';
      const body = dir === 'pix2usdt'
        ? { amountBRL: amt, walletAddress: dest, network: net }
        : { amountUSDT: amt, pixKey: dest, network: net };

      const r = await fetch(API + endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const d = await r.json();
      if (!d.success) throw new Error(d.error || 'Erro ao criar transação');

      if (dir === 'pix2usdt') showPixPayment(d);
      else showDeposit(d);
    } else {
      // demo
      if (dir === 'pix2usdt') showPixPayment(demoP2U(amt, dest));
      else showDeposit(demoU2P(amt, dest));
    }
  } catch (err) {
    toast('⚠️ ' + err.message);
  } finally {
    setDir(dir); // reseta form
  }
}

/* ═══ TELA: PAGAR PIX ═════════════════════════════════════ */
function showPixPayment(tx) {
  $('modalTitle').textContent = 'Pague o Pix';
  $('modalSub').textContent = 'Depois do pagamento, tudo acontece sozinho.';

  const usdt = (tx.estimatedUSDT ?? 0).toFixed(4);
  $('modalBody').innerHTML = `
    <div class="amt-banner">
      <div class="ab-l">Valor exato do Pix</div>
      <div class="ab-v">R$ ${Number(tx.amountBRL).toFixed(2).replace('.', ',')}</div>
      <div class="ab-s">→ ${usdt} USDT chegam na sua carteira</div>
    </div>

    <div class="qr-holder" id="qrHolder"></div>

    <div class="copy-row">
      <input id="pixCode" value="${tx.pixCode}" readonly aria-label="Código Pix copia e cola" />
      <button class="btn-copy" onclick="copyTxt('pixCode', this)">Copiar</button>
    </div>

    <div class="timer-line"><span>O código expira em</span><span id="tLabel">15:00</span></div>
    <div class="timer-bar"><div class="tb-fill" id="tFill" style="width:100%"></div></div>

    <div class="tx-pipe" id="txPipe">${pipeHTML('awaiting_payment', 'pix2usdt')}</div>

    <div style="font-size:.72rem;color:var(--muted);text-align:center">
      Transação <span class="mono">${tx.txId.substring(0, 8)}</span> · acompanhamento automático ativado
    </div>
  `;

  openModal();

  // QR: usa imagem do backend se existir, senão gera local
  const holder = $('qrHolder');
  if (tx.qrCodeImage) {
    const img = document.createElement('img');
    img.src = tx.qrCodeImage; img.alt = 'QR Code Pix';
    holder.appendChild(img);
  } else {
    new QRCode(holder, { text: tx.pixCode, width: 180, height: 180, correctLevel: QRCode.CorrectLevel.M });
  }

  startCountdown(15 * 60);

  // Acompanhamento automático de status
  if (backendOnline) pollStatus(tx.txId, 'pix2usdt');
  else demoAdvance(tx, 'pix2usdt');
}

/* ═══ TELA: DEPÓSITO USDT ═════════════════════════════════ */
function showDeposit(tx) {
  $('modalTitle').textContent = 'Envie o USDT';
  $('modalSub').textContent = 'Assim que a rede confirmar, o Pix sai sozinho.';

  const brl = Number(tx.estimatedBRL ?? 0).toFixed(2).replace('.', ',');
  $('modalBody').innerHTML = `
    <div class="amt-banner">
      <div class="ab-l">Envie exatamente</div>
      <div class="ab-v">${Number(tx.amountUSDT).toFixed(4)} USDT</div>
      <div class="ab-s">→ R$ ${brl} chegam via Pix em ${tx.pixKey}</div>
    </div>

    <div class="warn-box">⚠️ Envie apenas USDT pela rede <strong>${tx.network === 'trc20' ? 'TRC-20 (Tron)' : 'ERC-20 (Ethereum)'}</strong>. Tokens enviados por outra rede serão perdidos.</div>

    <div class="qr-holder" id="qrHolder"></div>

    <div class="copy-row">
      <input id="depAddr" value="${tx.depositAddress}" readonly aria-label="Endereço de depósito" />
      <button class="btn-copy" onclick="copyTxt('depAddr', this)">Copiar</button>
    </div>

    <div class="tx-pipe" id="txPipe">${pipeHTML('awaiting_payment', 'usdt2pix')}</div>

    <div style="font-size:.72rem;color:var(--muted);text-align:center">
      Transação <span class="mono">${tx.txId.substring(0, 8)}</span> · acompanhamento automático ativado
    </div>
  `;

  openModal();
  new QRCode($('qrHolder'), { text: tx.depositAddress, width: 180, height: 180 });

  if (backendOnline) pollStatus(tx.txId, 'usdt2pix');
  else demoAdvance(tx, 'usdt2pix');
}

/* ═══ PIPELINE DE STATUS ══════════════════════════════════ */
const STEPS = {
  pix2usdt: [
    { key: 'awaiting_payment', t: 'Aguardando seu Pix', d: 'O banco ainda não confirmou o pagamento' },
    { key: 'pix_confirmed',    t: 'Pix recebido',        d: 'Pagamento liquidado pelo Banco Central' },
    { key: 'exchange_ordered', t: 'Convertendo',         d: 'Ordem de compra executada na exchange' },
    { key: 'sending_crypto',   t: 'Enviando USDT',       d: 'Transação transmitida na blockchain' },
    { key: 'completed',        t: 'Na sua carteira',     d: 'Conversão concluída' }
  ],
  usdt2pix: [
    { key: 'awaiting_payment', t: 'Aguardando USDT',  d: 'A rede ainda não confirmou o depósito' },
    { key: 'pix_confirmed',    t: 'USDT recebido',    d: 'Depósito confirmado na blockchain' },
    { key: 'exchange_ordered', t: 'Convertendo',      d: 'Venda executada na exchange' },
    { key: 'completed',        t: 'Pix enviado',      d: 'O dinheiro está na sua conta' }
  ]
};

function pipeHTML(status, flow) {
  const steps = STEPS[flow];
  let idx = steps.findIndex(s => s.key === status);
  if (idx < 0) idx = 0;
  return steps.map((s, i) => {
    const cls = i < idx ? 'done' : i === idx ? 'active' : '';
    const icon = i < idx ? '✓' : (i + 1);
    return `<div class="tp-step ${cls}">
      <div class="tp-dot">${icon}</div>
      <div class="tp-info"><div class="tp-t">${s.t}</div><div class="tp-d">${s.d}</div></div>
    </div>`;
  }).join('');
}

/* ═══ POLLING (backend real) ═══════════════════════════════ */
function pollStatus(txId, flow) {
  stopPoll();
  pollTimer = setInterval(async () => {
    try {
      const r = await fetch(`${API}/api/transaction/${txId}`);
      const d = await r.json();
      if (!d.success) return;
      const tx = d.transaction;

      const pipe = $('txPipe');
      if (pipe) pipe.innerHTML = pipeHTML(tx.status, flow);

      if (tx.status === 'completed') {
        stopPoll();
        showSuccess(tx, flow);
      }
      if (tx.status === 'failed') {
        stopPoll();
        toast('⚠️ A transação falhou. O valor será estornado automaticamente.');
      }
      if (tx.status === 'expired') {
        stopPoll();
        toast('⏰ O código expirou sem pagamento. Gere um novo quando quiser.');
        closeModal();
      }
    } catch (e) { /* tenta de novo no próximo tick */ }
  }, 3000);
}

function stopPoll() {
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
}

/* ═══ SUCESSO ═════════════════════════════════════════════ */
function showSuccess(tx, flow) {
  const isP2U = flow === 'pix2usdt';
  const explorer = tx.network === 'erc20'
    ? `https://etherscan.io/tx/${tx.tx_hash}`
    : `https://tronscan.org/#/transaction/${tx.tx_hash}`;

  $('modalTitle').textContent = 'Concluído';
  $('modalSub').textContent = '';
  $('modalBody').innerHTML = `
    <div class="done-box">
      <div class="done-ic">${isP2U ? '🛰️' : '💠'}</div>
      <h3>${isP2U ? 'USDT na sua carteira' : 'Pix enviado'}</h3>
      <p class="d-sub">${isP2U
        ? `${Number(tx.amount_usdt).toFixed(4)} USDT enviados via ${tx.network === 'trc20' ? 'TRC-20' : 'ERC-20'}`
        : `R$ ${Number(tx.amount_brl).toFixed(2).replace('.', ',')} enviados para ${tx.pix_key}`}</p>
      ${tx.tx_hash ? `
        <div class="hash-box">
          <div style="font-size:.62rem;letter-spacing:.06em;text-transform:uppercase;margin-bottom:4px">Hash da transação</div>
          ${tx.tx_hash}<br><br>
          <a href="${explorer}" target="_blank" rel="noopener">Ver no explorador ↗</a>
        </div>` : ''}
      <button class="btn-go" onclick="closeModal()">Fazer outra conversão</button>
    </div>
  `;
  toast(isP2U ? '✅ USDT entregue na carteira' : '✅ Pix enviado');
}

/* ═══ TIMER ═══════════════════════════════════════════════ */
function startCountdown(total) {
  let s = total;
  if (countdownTimer) clearInterval(countdownTimer);
  countdownTimer = setInterval(() => {
    s--;
    const lbl = $('tLabel'), fill = $('tFill');
    if (lbl) lbl.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    if (fill) fill.style.width = (s / total * 100) + '%';
    if (s <= 0) { clearInterval(countdownTimer); }
  }, 1000);
}

/* ═══ MODO DEMONSTRAÇÃO (backend offline) ═════════════════ */
function demoP2U(amt, dest) {
  return {
    txId: 'demo-' + Date.now().toString(36),
    amountBRL: amt,
    estimatedUSDT: amt / rate * (1 - feePct / 100),
    pixCode: '00020126580014BR.GOV.BCB.PIX0136demo@pixswap.io520400005303986540' + amt.toFixed(2) + '5802BR5907PixSwap6009SAO PAULO62070503***6304ABCD',
    qrCodeImage: null,
    network: net, walletAddress: dest
  };
}
function demoU2P(amt, dest) {
  return {
    txId: 'demo-' + Date.now().toString(36),
    amountUSDT: amt,
    estimatedBRL: amt * rate * (1 - feePct / 100),
    depositAddress: net === 'trc20' ? 'TDemoPixSwapDepositAddr0000000000' : '0xDemoPixSwapDepositAddress000000000000000',
    pixKey: dest, network: net
  };
}
function demoAdvance(tx, flow) {
  const seq = STEPS[flow].map(s => s.key);
  let i = 0;
  const iv = setInterval(() => {
    i++;
    const pipe = $('txPipe');
    if (!pipe) { clearInterval(iv); return; }
    if (i >= seq.length - 1) {
      clearInterval(iv);
      const fake = flow === 'pix2usdt'
        ? { ...tx, amount_usdt: tx.estimatedUSDT, network: tx.network, tx_hash: '0x' + 'ab12'.repeat(16) }
        : { ...tx, amount_brl: tx.estimatedBRL, pix_key: tx.pixKey, tx_hash: null };
      showSuccess(fake, flow);
    } else {
      pipe.innerHTML = pipeHTML(seq[i], flow);
    }
  }, 2600);
}

/* ═══ UTIL ════════════════════════════════════════════════ */
function openModal() { $('overlay').classList.add('open'); document.body.style.overflow = 'hidden'; }
function closeModal() {
  $('overlay').classList.remove('open');
  document.body.style.overflow = '';
  stopPoll();
}
$('overlay').addEventListener('click', e => { if (e.target === $('overlay')) closeModal(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

function copyTxt(id, btn) {
  navigator.clipboard.writeText($(id).value).then(() => {
    const old = btn.textContent;
    btn.textContent = '✓ Copiado';
    setTimeout(() => btn.textContent = old, 1800);
  });
}

function toast(msg) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 4000);
}

/* ═══ INIT ════════════════════════════════════════════════ */
loadRate();
setInterval(loadRate, 30000);
checkReady();
</script>
</body>
</html>
